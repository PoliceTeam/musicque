{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "client",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "cwd": "client",
      "port": 8080
    },
    {
      "name": "api",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-c",
        "source \"$HOME/.nvm/nvm.sh\" && nvm use >/dev/null && node server.js"
      ],
      "cwd": "api",
      "port": 5001
    }
  ]
}
