XIANGQI_ENGINE_MAX_RETRIES=1
XIANGQI_ENGINE_MOVE_MS=800
XIANGQI_ENGINE_WORKERS=2
XIANGQI_RECENT_PUZZLES=20
XIANGQI_REWARD_EASY=15
