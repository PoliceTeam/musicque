XIANGQI_TIME_MEDIUM_SECONDS=60
YOUTUBE_API_KEY=
NODE_ENV=production
THIRTEEN_MAX_TABLES=20
THIRTEEN_READY_COUNTDOWN_MS=3000
THIRTEEN_READY_TIMEOUT_MS=30000
THIRTEEN_IDLE_SEAT_MS=300000
THIRTEEN_STAKE_PC=10
THIRTEEN_TURN_MS=20000
THIRTEEN_BOT_DELAY_MS=1200
SESSION_AUTO_END_HOUR=18

# SERVICE: client
# Client (VITE_* là build-time)
# REQUIRED: VITE_API_URL
VITE_API_URL=https://musicque.politetech.com
VITE_RESPONSIVE_VOICE_KEY=
# REQUIRED: VITE_SOCKET_URL
VITE_SOCKET_URL=https://musicque.politetech.com

# SERVICE: mongodb
# MongoDB (root auth tùy chọn, bật theo cặp)
MONGO_INITDB_DATABASE=music-order-app
MONGO_INITDB_ROOT_PASSWORD=
MONGO_INITDB_ROOT_USERNAME=

# SERVICE: vieneu-tts
# VieNeu-TTS / Edge TTS
EDGE_TTS_PITCH=+0Hz
EDGE_TTS_RATE=+0%
EDGE_TTS_VOICE=vi-VN-NamMinhNeural
EDGE_TTS_VOLUME=+0%
MKL_NUM_THREADS=4
NUMEXPR_NUM_THREADS=4
OMP_NUM_THREADS=4
OPENBLAS_NUM_THREADS=4
VIENEU_APPLY_WATERMARK=false
VIENEU_HOST=0.0.0.0
VIENEU_INFER_MAX_CHARS=200
VIENEU_INFER_MAX_NEW_FRAMES=180
VIENEU_INFER_REPETITION_PENALTY=1.15
VIENEU_INFER_TEMPERATURE=0.65
VIENEU_INFER_TOP_K=10
VIENEU_INFER_TOP_P=0.85
VIENEU_PORT=8100
