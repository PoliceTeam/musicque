# Override remote.sh qua shell: SERVER, SSH_KEY, REMOTE_DIR (xem docs/deploy.md).
# Production police; sao chép thành .env.prod, chmod 600. Không commit env thật.
# REQUIRED: nhãn cho biến bắt buộc; các biến khác là tùy chọn.
# Sinh secret mới: openssl rand -hex 32. Giữ nguyên secret/DB credential hiện có khi chuyển đổi.
# Client secret khớp Keycloak; SSO_TOKEN_KEY là 32 byte hex riêng của Musicque.
# MONGO_INITDB_ROOT_* chỉ dùng khi khởi tạo DB mới; không đổi tài khoản của volume hiện có.
# Nếu dùng Mongo auth, sửa MONGODB_URI với authSource=admin và mật khẩu đã URL-encode.
# API key bên thứ ba phải lấy từ nhà cung cấp; VITE_* được công khai trong bundle.
# VITE_API_URL/VITE_SOCKET_URL cần rebuild client khi thay đổi.

# SERVICE: api
# API / gameplay / SSO
# REQUIRED: ADMIN_PASSWORD
ADMIN_PASSWORD=
# REQUIRED: ADMIN_USERNAME
ADMIN_USERNAME=admin
BILLIARDS_AIM_BALL_IN_HAND_MS=4200
BILLIARDS_AIM_BREAK_MS=4000
BILLIARDS_AIM_MS=3200
BILLIARDS_INTERMISSION_MS=27000
BILLIARDS_MAX_BET=50
BILLIARDS_MIN_BET=5
BILLIARDS_MISS_CHANCE=0.05
BILLIARDS_RETENTION_MS=7200000
BILLIARDS_SETTLE_MS=1100
BILLIARDS_SETTLE_POT_MS=1900
BILLIARDS_WAIT_MS=20000
CHOHAN_BET_MS=45000
CHOHAN_MAX_BET=15
CHOHAN_MIN_BET=5
CHOHAN_REVEAL_MS=5000
CHOHAN_SHAKE_MS=10000
# REQUIRED: CLIENT_URL
CLIENT_URL=https://musicque.politetech.com
DAILY_BONUS_PC=20
EDGE_TTS_ENABLED=true
EDGE_TTS_PITCH=+0Hz
EDGE_TTS_RATE=+0%
EDGE_TTS_TIMEOUT=15000
EDGE_TTS_VOICE=vi-VN-NamMinhNeural
EDGE_TTS_VOLUME=+0%
JUNGLE_CLOCK_MS=900000
JUNGLE_DISCONNECT_MS=180000
JUNGLE_GAME_RETENTION_MS=2592000000
JUNGLE_REPETITION_LIMIT=12
JUNGLE_STAKE_PC=100
JWT_EXPIRES_IN=7d
# REQUIRED: JWT_SECRET
JWT_SECRET=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=
LOTTERY_CUTOFF_HOUR=18
LOTTERY_GIVEUP_HOUR=7
LOTTERY_MAX_STAKE=50
LOTTERY_RETRY_MS=180000
LOTTERY_RSS_URL=https://xskt.com.vn/rss-feed/mien-bac-xsmb.rss
LOTTERY_SETTLE_HOUR=19
# REQUIRED: MONGODB_URI
MONGODB_URI=mongodb://mongodb:27017/music-order-app
# REQUIRED: PORT
PORT=5000
SIGNUP_START_BALANCE=100
# REQUIRED: SOCKET_URL
SOCKET_URL=https://musicque.politetech.com
SONG_SKIP_PC_THRESHOLD=100
SSO_ADMIN_URL=http://sso:8080/sso
# REQUIRED: SSO_CLIENT_ID
SSO_CLIENT_ID=musicque
# REQUIRED: SSO_CLIENT_SECRET
SSO_CLIENT_SECRET=
SSO_HANDOFF_ORIGINS=https://musicque.politetech.com
SSO_HANDOFF_TARGETS=musicque-farm=https://musicque.politetech.com/farm/api/auth/handoff/accept
# SSO: production bật cả nhóm; SSO_ADMIN_URL là địa chỉ nội bộ container.
# REQUIRED: SSO_ISSUER
SSO_ISSUER=https://musicque.politetech.com/sso/realms/sso
# REQUIRED: SSO_REDIRECT_URI
SSO_REDIRECT_URI=https://musicque.politetech.com/api/auth/sso/callback
# REQUIRED: SSO_TOKEN_KEY
SSO_TOKEN_KEY=
# REQUIRED: SSO_WEB_ORIGIN
SSO_WEB_ORIGIN=https://musicque.politetech.com
TZ=Asia/Ho_Chi_Minh
VIENEU_TTS_CACHE_MAX_AGE_DAYS=30
VIENEU_TTS_CACHE_MAX_FILES=1000
VIENEU_TTS_CACHE_VERSION=vieneu-preset-v1
VIENEU_TTS_ENABLED=true
VIENEU_TTS_HEALTH_TIMEOUT=5000
VIENEU_TTS_PRIMARY_TIMEOUT=30000
VIENEU_TTS_QUEUE_MAX_SIZE=50
VIENEU_TTS_RATE_MAX_REQUESTS=20
VIENEU_TTS_RATE_WINDOW_MS=60000
VIENEU_TTS_SPEECH_MAX_CHARS=200
VIENEU_TTS_SYNC_WAIT_MS=2500
VIENEU_TTS_TIMEOUT=180000
VIENEU_TTS_URL=http://vieneu-tts:8100
VIENEU_TTS_VOICE=Ngọc Lan
VIENEU_TTS_WARM_QUEUE_CONCURRENCY=1
WC2026_API_KEY=
WEATHER_API_KEY=
WEATHER_LOCATION=
WORDCHAIN_BETWEEN_ROUNDS_MS=5000
WORDCHAIN_BOT_ENABLED=true
WORDCHAIN_BOT_TRIGGER_MS=1000
