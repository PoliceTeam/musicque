# Optional. All five values must be provided together to enable SSO.
# Local secrets are generated in musicque-farm/apps/sso/.env.musicque.
# Configure CLIENT_URL to include SSO_WEB_ORIGIN; proxy /api to this Express backend.
# Admin REST nội bộ (vd http://sso:8080/sso) khi nginx chặn /sso/admin từ Internet; để trống = suy từ SSO_ISSUER.
SSO_ADMIN_URL=
SSO_ISSUER=
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
SSO_REDIRECT_URI=
SSO_WEB_ORIGIN=

# Backend only: 32 random bytes encoded as 64 hex characters.
SSO_TOKEN_KEY=
# Comma separated clientId=absolute accept URL; HTTPS outside loopback dev.
SSO_HANDOFF_TARGETS=musicque-farm=https://farm.example/api/auth/handoff/accept
# Origin web đối tác được POST bàn giao vào đây (phân cách bằng dấu phẩy); origin của chính Musicque luôn được phép.
SSO_HANDOFF_ORIGINS=https://farm.example
